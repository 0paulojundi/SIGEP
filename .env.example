# ============================================================
# SIGEP — configuração do back-end.
# Copie este arquivo para ".env" (na raiz do projeto, ao lado de README.md) e ajuste.
# O ".env" NUNCA deve ir para o GitHub nem ficar acessível pela web.
# ============================================================

APP_ENV=local                 # local | production
APP_DEBUG=false               # true só em desenvolvimento (mostra detalhes de erro 500)
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo

# ---- Persistência ----
# file  = arquivos JSON em backend/storage/data (TEMPORÁRIO, para testar sem banco)
# array = só memória (testes automatizados)
# pdo   = banco de dados via PDO (quando o MySQL existir; veja README)
STORAGE_DRIVER=array

# ---- Dados de demonstração (só para STORAGE_DRIVER=file/array) ----
# Cria usuários, alunos e atendimentos de exemplo na primeira execução.
# Todos os usuários demo usam a senha abaixo (troque!). Desligue em produção.
SEED_DEMO=false
DEMO_PASSWORD=Sigep@Demo2026

# ---- Banco de dados (só com STORAGE_DRIVER=pdo) — preencher quando o banco existir ----
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_CHARSET=utf8mb4

# ---- Segurança ----
PASSWORD_MIN_LENGTH=8
LOGIN_MAX_ATTEMPTS=5          # tentativas de login por e-mail+IP...
LOGIN_WINDOW_SECONDS=900      # ...dentro desta janela (15 min) antes de bloquear
SESSION_IDLE_SECONDS=1800     # expira após 30 min sem uso
SESSION_ABSOLUTE_SECONDS=28800  # expira após 8 h, mesmo com uso
SELF_REGISTRATION=true        # permite o "Cadastre-se" público dos responsáveis
AUTO_STATUS=true              # status automático (veja as duas linhas abaixo); false desliga tudo
ATRASO_CANCELA_MINUTOS=10     # agendamento Confirmado não iniciado depois deste atraso vira Cancelado (0 = desliga)
ATENDIMENTO_MAX_MINUTOS=180   # duração máxima de um atendimento (3 h); 0 = sem limite
ORIENTADOR_VE_TODOS=true      # true: orientador consulta os atendimentos de todos (só age nos próprios); false: só os dele (mais restritivo, LGPD)
# Origens extras permitidas (CORS), separadas por vírgula. Vazio = só a mesma origem.
CORS_ALLOWED_ORIGINS=

# ---- Redefinição de senha / e-mail ----
PASSWORD_RESET_MINUTES=60
# {token} é substituído pelo token. Ajuste para a página do front que receberá o link.
PASSWORD_RESET_URL=http://localhost:8000/#redefinir-senha/{token}
# log    = não envia: grava em backend/storage/logs/mail.log (desenvolvimento)
# native = usa a função mail() do PHP
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=nao-responda@seudominio.com.br
MAIL_FROM_NAME=SIGEP
